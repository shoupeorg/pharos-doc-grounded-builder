{
  "name": "pharos-doc-grounded-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": { "pharos-doc-builder": "./src/cli.js" },
  "scripts": {
    "test": "node --test",
    "build": "rollup -c",
    "check": "npm test && npm run build",
    "cli": "node src/cli.js",
    "deploy": "npm run build && wrangler deploy --no-bundle",
    "db:migrate:remote": "wrangler d1 migrations apply pharos-doc-grounded-builder --remote",
    "capture:evidence": "node scripts/capture-corrected-evidence.mjs",
    "capture:evidence:v1.0-historical": "node scripts/capture-live-evidence.mjs"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1" },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.64.9",
    "wrangler": "4.151.1"
  },
  "engines": { "node": ">=20" }
}
